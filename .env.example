# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto del examen: 3011. 127.0.0.1 = solo acepta conexiones del mismo equipo
# (en servidor2 el que llega es Apache, que está en ese mismo equipo).
PORT=3011
HOST=127.0.0.1

# Base de datos MySQL de este microservicio (en servidor2: DB_HOST = IP de servidor1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eventos_db
DB_USER=eventos_user
DB_PASSWORD=una-clave-segura

# La MISMA clave que tiene ms-usuarios en su .env: con ella se verifica el token
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta

# Dirección de ms-auditorios (proveedor): valida auditorio_id y compone la respuesta
AUDITORIOS_URL=http://127.0.0.1:3012
