{
  "info": {
    "name": "ms-eventos",
    "description": "Pruebas de ms-eventos (Evaluación M3 · preparación). Ejecutar en orden con el Runner.\n\nRequiere corriendo ms-usuarios (3001) y ms-eventos (3011).\nLos 00 hacen login y guardan los tokens solos.\nVariables: {{base}} = ms-eventos, {{usuarios}} = ms-usuarios. Para probar a través del gateway: base = http://<host>/api y usuarios = http://<host>/api. admin_email y admin_password: las del ms-usuarios donde se prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:3011"
    },
    {
      "key": "usuarios",
      "value": "http://localhost:3001"
    },
    {
      "key": "admin_email",
      "value": "admin@empresa.com"
    },
    {
      "key": "admin_password",
      "value": "Admin2026*"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token_medico",
      "value": ""
    },
    {
      "key": "codigo_nuevo",
      "value": ""
    },
    {
      "key": "evento_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00a · Login administrador → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{usuarios}}/usuarios/login",
          "host": [
            "{{usuarios}}"
          ],
          "path": [
            "usuarios",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
